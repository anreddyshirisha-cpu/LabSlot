# Shared Laboratory Equipment Booking and Conflict Prevention System
# Environment Configuration Template

# Application Server
PORT=3000
NODE_ENV=development

# Supabase Configuration
# Obtain these from your Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Authentication & Session Security
JWT_SECRET=super-secret-lab-jwt-token-key-change-in-production-2026
SESSION_EXPIRY=24h

# Lab Operational Defaults
DEFAULT_BUFFER_TIME_MINS=15
MAX_BOOKING_HOURS=4
AUTO_FLAG_OVERDUE_MINUTES=15
